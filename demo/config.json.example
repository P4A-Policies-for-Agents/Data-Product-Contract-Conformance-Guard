{
  "cdgcLoginUrl": "https://dm-us.informaticacloud.com",
  "cdgcSearchUrl": "https://cdgc-api.dm-us.informaticacloud.com",
  "cdgcOrgUsername": "REPLACE_ME_SERVICE_ACCOUNT",
  "cdgcOrgPassword": "REPLACE_ME_SECRET",
  "catalogId": "REPLACE_ME_CATALOG_SOURCE_ID",
  "flatFileId": "REPLACE_ME_FLATFILE_ID",
  "recordsPath": "products",
  "sensitiveMarker": "confidential",
  "onUnexpectedField": "strip",
  "onMissingRequired": "reject",
  "onTypeMismatch": "inform",
  "onSensitiveField": "strip",
  "refreshIntervalSeconds": 86400,
  "failOpenOnCdgcError": true,
  "distributed": false,
  "timeout": 5000
}
